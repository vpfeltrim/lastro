{
  "description": "lastro — inerte em projeto sem .claude/memoria.yaml",
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lastro", "args": ["hook-inicio"], "timeout": 30 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lastro", "args": ["hook-guarda"], "timeout": 10 } ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lastro", "args": ["hook-guarda-bash"], "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lastro", "args": ["hook-formato"], "timeout": 30 } ] },
      { "matcher": "Bash|mcp__.*",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lastro", "args": ["hook-captura"], "timeout": 10 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash|mcp__.*",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lastro", "args": ["hook-captura"], "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lastro", "args": ["hook-fim"], "timeout": 60 } ] }
    ]
  }
}
